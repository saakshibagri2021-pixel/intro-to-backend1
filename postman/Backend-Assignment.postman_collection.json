{
  "info": {
    "name": "Backend Assignment API",
    "description": "Postman collection for user authentication and Post CRUD endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sakshi\",\n  \"email\": \"sakshi@example.com\",\n  \"password\": \"pass1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('userId', pm.response.json().user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sakshi@example.com\",\n  \"password\": \"pass1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/{{userId}}/logout"
          }
        }
      ]
    },
    {
      "name": "Posts CRUD",
      "item": [
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample post\",\n  \"description\": \"My first backend post\",\n  \"age\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('postId', pm.response.json().post._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Get post by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Update post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\",\n  \"age\": 21\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        }
      ]
    }
  ]
}